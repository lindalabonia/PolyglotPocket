<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme (dark). Colors come from values-night/colors.xml. -->
    <style name="Base.Theme.PolyglotPocket" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/pp_primary</item>
        <item name="colorOnPrimary">@color/pp_on_primary</item>
        <item name="colorPrimaryContainer">@color/pp_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/pp_on_primary_container</item>
        <item name="colorSecondary">@color/pp_primary</item>
        <item name="colorOnSecondary">@color/pp_on_primary</item>
        <item name="colorSecondaryContainer">@color/pp_primary_container</item>
        <item name="colorOnSecondaryContainer">@color/pp_on_primary_container</item>
        <item name="android:colorBackground">@color/pp_background</item>
        <item name="colorSurface">@color/pp_surface</item>
        <item name="colorSurfaceVariant">@color/pp_surface_variant</item>
        <item name="colorOnSurface">@color/pp_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/pp_on_surface_variant</item>
        <item name="colorOutline">@color/pp_outline</item>
        <item name="colorOutlineVariant">@color/pp_outline</item>
        <!-- One font across the whole app -->
        <item name="android:fontFamily">@font/outfit</item>
        <item name="fontFamily">@font/outfit</item>
    </style>
</resources>
