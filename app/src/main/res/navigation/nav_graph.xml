<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.polyglotpocket.ui.login.LoginFragment"
        android:label="@string/login_title"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_login_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.polyglotpocket.ui.home.HomeFragment"
        android:label="@string/app_name"
        tools:layout="@layout/fragment_home">

        <!-- Action to open training screen -->
        <action
            android:id="@+id/action_home_to_training"
            app:destination="@id/trainingFragment" />

        <!-- Debug action for API testing -->
        <action
            android:id="@+id/action_home_to_apitest"
            app:destination="@id/apiTestFragment" />

        <!-- Add word from photo (REQ. 6) -->
        <action
            android:id="@+id/action_home_to_photo"
            app:destination="@id/photoCaptureFragment" />
    </fragment>

    <!-- Training screen -->
    <fragment
        android:id="@+id/trainingFragment"
        android:name="com.example.polyglotpocket.ui.training.TrainingFragment"
        android:label="@string/training_title"
        tools:layout="@layout/fragment_training" />

    <fragment
        android:id="@+id/apiTestFragment"
        android:name="com.example.polyglotpocket.ui.apitest.ApiTestFragment"
        android:label="@string/apitest_title"
        tools:layout="@layout/fragment_api_test" />

    <!-- Photo flow (REQ. 6): capture/pick -> detect -> select -> translate + add -->
    <fragment
        android:id="@+id/photoCaptureFragment"
        android:name="com.example.polyglotpocket.ui.photo.PhotoCaptureFragment"
        android:label="@string/photo_title"
        tools:layout="@layout/fragment_photo_capture">
        <argument
            android:name="targetLang"
            app:argType="string" />
        <action
            android:id="@+id/action_photo_capture_to_result"
            app:destination="@id/photoResultFragment" />
    </fragment>

    <fragment
        android:id="@+id/photoResultFragment"
        android:name="com.example.polyglotpocket.ui.photo.PhotoResultFragment"
        android:label="@string/photo_title"
        tools:layout="@layout/fragment_photo_result" />

    <!-- Statistics (REQ. 3) -->
    <fragment
        android:id="@+id/statisticsFragment"
        android:name="com.example.polyglotpocket.ui.stats.StatisticsFragment"
        android:label="@string/stats_title"
        tools:layout="@layout/fragment_statistics">
        <action
            android:id="@+id/action_stats_to_training"
            app:destination="@id/trainingFragment" />
    </fragment>

</navigation>