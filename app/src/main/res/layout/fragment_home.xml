<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Greeting -->
        <TextView
            android:id="@+id/welcomeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="25sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface"
            tools:text="Hi, Linda! 👋" />

        <!-- Streak (all languages) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/pp_tint_amber_bg"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="14dp">

                <TextView
                    android:id="@+id/streakEmoji"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:text="😔"
                    android:textSize="22sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/streakText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface"
                        android:text="@string/home_streak_none_title"
                        tools:text="5-day streak" />

                    <TextView
                        android:id="@+id/streakSubText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:text="@string/home_streak_none_sub"
                        tools:text="You've practiced 5 days in a row" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Section: training options -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/home_welcome_sub"
            android:textAllCaps="true"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.06"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <!-- Language selector -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/languageCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:clickable="true"
            android:focusable="true"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="?attr/colorSurface"
            app:strokeWidth="1dp"
            app:strokeColor="?attr/colorOutline">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_target_lang_label"
                        android:textAllCaps="true"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.06"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <TextView
                        android:id="@+id/selectedLanguageText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface"
                        tools:text="🇪🇸 Spanish" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_change"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:textColor="?attr/colorPrimary" />

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginStart="2dp"
                    android:src="@drawable/ic_chevron_right"
                    android:contentDescription="@string/home_change"
                    app:tint="?attr/colorPrimary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Random training -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/trainRandomButton"
            style="@style/FeatureCard">

            <LinearLayout style="@style/FeatureRow">
                <FrameLayout
                    style="@style/FeatureIconBox"
                    android:backgroundTint="@color/pp_tint_violet_bg">
                    <ImageView
                        style="@style/FeatureIcon"
                        android:src="@drawable/ic_shuffle"
                        app:tint="@color/pp_tint_violet_fg" />
                </FrameLayout>
                <LinearLayout style="@style/FeatureText">
                    <TextView style="@style/FeatureTitle" android:text="@string/home_train_random" />
                    <TextView style="@style/FeatureSub" android:text="@string/home_train_random_sub" />
                </LinearLayout>
                <ImageView style="@style/FeatureChevron" android:src="@drawable/ic_chevron_right" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Review your mistakes -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/trainErrorsButton"
            style="@style/FeatureCard">

            <LinearLayout style="@style/FeatureRow">
                <FrameLayout
                    style="@style/FeatureIconBox"
                    android:backgroundTint="@color/pp_tint_amber_bg">
                    <ImageView
                        style="@style/FeatureIcon"
                        android:src="@drawable/ic_review"
                        app:tint="@color/pp_tint_amber_fg" />
                </FrameLayout>
                <LinearLayout style="@style/FeatureText">
                    <TextView style="@style/FeatureTitle" android:text="@string/home_train_errors" />
                    <TextView style="@style/FeatureSub" android:text="@string/home_train_errors_sub" />
                </LinearLayout>
                <ImageView style="@style/FeatureChevron" android:src="@drawable/ic_chevron_right" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Study here (GPS) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/studyHereButton"
            style="@style/FeatureCard">

            <LinearLayout style="@style/FeatureRow">
                <FrameLayout
                    style="@style/FeatureIconBox"
                    android:backgroundTint="@color/pp_tint_green_bg">
                    <ImageView
                        style="@style/FeatureIcon"
                        android:src="@drawable/ic_location"
                        app:tint="@color/pp_tint_green_fg" />
                </FrameLayout>
                <LinearLayout style="@style/FeatureText">
                    <TextView style="@style/FeatureTitle" android:text="@string/home_study_here" />
                    <TextView style="@style/FeatureSub" android:text="@string/home_study_here_sub" />
                </LinearLayout>
                <ImageView style="@style/FeatureChevron" android:src="@drawable/ic_chevron_right" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Add word from photo -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/addPhotoButton"
            style="@style/FeatureCard">

            <LinearLayout style="@style/FeatureRow">
                <FrameLayout
                    style="@style/FeatureIconBox"
                    android:backgroundTint="@color/pp_tint_blue_bg">
                    <ImageView
                        style="@style/FeatureIcon"
                        android:src="@drawable/ic_camera"
                        app:tint="@color/pp_tint_blue_fg" />
                </FrameLayout>
                <LinearLayout style="@style/FeatureText">
                    <TextView style="@style/FeatureTitle" android:text="@string/home_add_photo" />
                    <TextView style="@style/FeatureSub" android:text="@string/home_add_photo_sub" />
                </LinearLayout>
                <ImageView style="@style/FeatureChevron" android:src="@drawable/ic_chevron_right" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== Your progress (all languages) ===== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/home_progress_title"
            android:textAllCaps="true"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.06"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <!-- Practice calendar (collapsible) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="?attr/colorSurface"
            app:strokeWidth="1dp"
            app:strokeColor="?attr/colorOutline">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/calendarHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground"
                    android:padding="15dp">

                    <ImageView
                        android:id="@+id/calendarChevron"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginEnd="8dp"
                        android:src="@drawable/ic_chevron_right"
                        android:contentDescription="@null"
                        app:tint="?attr/colorOnSurfaceVariant" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/home_calendar_title"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface" />

                    <TextView
                        android:id="@+id/calendarHint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_calendar_hint"
                        android:textSize="11sp"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/calendarBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp"
                    android:paddingBottom="15dp">

                    <com.example.polyglotpocket.ui.widgets.CalendarHeatmapView
                        android:id="@+id/calendarView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="5dp"
                            android:text="@string/home_calendar_less"
                            android:textSize="10sp"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <View android:layout_width="10dp" android:layout_height="10dp" android:layout_marginEnd="3dp" android:background="@color/pp_heat_0" />
                        <View android:layout_width="10dp" android:layout_height="10dp" android:layout_marginEnd="3dp" android:background="@color/pp_heat_1" />
                        <View android:layout_width="10dp" android:layout_height="10dp" android:layout_marginEnd="3dp" android:background="@color/pp_heat_2" />
                        <View android:layout_width="10dp" android:layout_height="10dp" android:layout_marginEnd="3dp" android:background="@color/pp_heat_3" />
                        <View android:layout_width="10dp" android:layout_height="10dp" android:layout_marginEnd="5dp" android:background="@color/pp_heat_4" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_calendar_more"
                            android:textSize="10sp"
                            android:textColor="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- KPI tiles -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="9dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:strokeWidth="1dp"
                app:strokeColor="?attr/colorOutline">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <FrameLayout
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_feature_icon"
                        android:backgroundTint="@color/pp_tint_violet_bg">
                        <ImageView
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_stats"
                            android:contentDescription="@null"
                            app:tint="@color/pp_tint_violet_fg" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/kpiSessions"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textSize="19sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface"
                        android:text="—"
                        tools:text="42" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_kpi_sessions"
                        android:textSize="11sp"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="9dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:strokeWidth="1dp"
                app:strokeColor="?attr/colorOutline">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <FrameLayout
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_feature_icon"
                        android:backgroundTint="@color/pp_tint_blue_bg">
                        <ImageView
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_theme_objects"
                            android:contentDescription="@null"
                            app:tint="@color/pp_tint_blue_fg" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/kpiCards"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textSize="19sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface"
                        android:text="—"
                        tools:text="388" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_kpi_cards"
                        android:textSize="11sp"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:strokeWidth="1dp"
                app:strokeColor="?attr/colorOutline">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <FrameLayout
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_feature_icon"
                        android:backgroundTint="@color/pp_tint_amber_bg">
                        <ImageView
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_theme_time"
                            android:contentDescription="@null"
                            app:tint="@color/pp_tint_amber_fg" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/kpiTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textSize="19sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface"
                        android:text="—"
                        tools:text="2h 14m" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_kpi_time"
                        android:textSize="11sp"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
